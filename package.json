{
	"name": "espmatter-studio",
	"private": true,
	"version": "0.3.0",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "pnpm@12.17.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen:matter": "node scripts/gen-matter-model.ts",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@types/node": "^24",
		"@types/w3c-web-serial": "^1.0.9",
		"@types/ws": "^8.18.2",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#sdk": "./src/lib/sdk/index.ts",
		"#sdk/device-ui": "./src/lib/sdk/device-ui/index.ts",
		"#sdk/matter": "./src/lib/sdk/matter.ts",
		"#sdk/*": "./src/lib/sdk/*",
		"#plugins/*": "./plugins/*"
	},
	"dependencies": {
		"@libsql/client": "^0.17.3",
		"@lucide/svelte": "^1.67.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"drizzle-orm": "^0.45.2",
		"esptool-js": "^0.7.1",
		"fflate": "^0.8.3",
		"svelte": "^5.57.2",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.0",
		"valibot": "^1.5.0",
		"vite": "^8.3.0",
		"ws": "^8.22.1"
	}
}
