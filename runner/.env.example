# Shown once when adding the runner under Admin → Build runners.
RUNNER_TOKEN=

# Address of the app, as seen from this runner (the runner only calls the app).
# On the app's host, e.g. http://localhost:5173.
APP_URL=

# ESP-IDF image tag, e.g. v5.4.2.
IDF_VERSION=

# Parallel builds (1-8).
RUNNER_CONCURRENCY=
