# The URL the app is reached at: 
# http://localhost:3000 (the default) or your public URL for production.
ORIGIN="http://localhost:3000"

# Better Auth: 32 characters with high entropy, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Local development only (the Docker image provides ESP-IDF): the ESP-IDF v5.5.6 checkout
# (default location of the Espressif install guide).
IDF_PATH="${HOME}/esp/esp-idf"
# Optional: the python ESP-IDF was installed with, if it isn't the default one.
IDF_PYTHON=""
