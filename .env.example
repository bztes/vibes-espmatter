# Directory for the database and firmware artifacts.
DATA_DIR=./data

# Only for plain http: URL the app is opened with, otherwise form submissions fail with 403.
# Leave it unset behind an https reverse proxy like Caddy.
# ORIGIN=http://server:3000

# Behind a reverse proxy / TLS terminator, set ADDRESS_HEADER=X-Forwarded-For (and XFF_DEPTH
# to the number of proxies) so the app sees real client addresses – the login limit for remote
# access is per client. Leave unset when clients connect directly (the header could be faked).
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
